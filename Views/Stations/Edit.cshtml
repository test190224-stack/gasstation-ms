@model GasStationMS.Models.Station
@{ ViewData["Title"] = "Խմբագրել կայանը"; }

<h1>✏️ Խմբագրել՝ @Model.Name</h1>

<div class="content-card" style="max-width: 700px;">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Կայանի անունը</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Address" class="form-label">Հասցե</label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="City" class="form-label">Քաղաք</label>
                <input asp-for="City" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="PhoneNumber" class="form-label">Հեռախոս</label>
                <input asp-for="PhoneNumber" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Latitude" class="form-label">Լայնություն</label>
                <input asp-for="Latitude" type="number" step="0.0001" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Longitude" class="form-label">Երկարություն</label>
                <input asp-for="Longitude" type="number" step="0.0001" class="form-control" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">Կարգավիճակ</label>
            <select asp-for="Status" class="form-select">
                <option value="1">Ակտիվ</option>
                <option value="2">Տեխսպասարկում</option>
                <option value="3">Փակ</option>
            </select>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Պահպանել</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Չեղարկել</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
