@model GasStationMS.Models.Supplier
@{ ViewData["Title"] = "Նոր մատակարար"; }

<h1>🏭 Նոր մատակարարի գրանցում</h1>

<div class="content-card" style="max-width: 700px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Name" class="form-label">Անվանում <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Օր․ «Արմենագազ»" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="TaxId" class="form-label">ՀՎՀՀ</label>
                <input asp-for="TaxId" class="form-control" />
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Address" class="form-label">Հասցե</label>
            <input asp-for="Address" class="form-control" />
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="PhoneNumber" class="form-label">Հեռախոս</label>
                <input asp-for="PhoneNumber" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label">Էլ․ փոստ</label>
                <input asp-for="Email" class="form-control" />
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="ContactPerson" class="form-label">Կոնտակտային անձ</label>
            <input asp-for="ContactPerson" class="form-control" placeholder="Պատասխանատու մենեջեր" />
        </div>
        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary">✅ Գրանցել</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Չեղարկել</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
